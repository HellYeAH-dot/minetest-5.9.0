
name: Build Minetest Windows
on:
  workflow_dispatch:
  push:
jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build Windows
        run: |
          vcpkg install irrlichtmt zlib curl[winssl] openal-soft libvorbis libogg sqlite3 freetype luajit zstd gettext --triplet x64-windows
          cmake -B build -DCMAKE_TOOLCHAIN_FILE=C:/vcpkg/scripts/buildsystems/vcpkg.cmake -DRUN_IN_PLACE=TRUE
          cmake --build build --config Release -j 4
